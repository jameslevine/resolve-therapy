# AWS Configuration
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

# AWS Bedrock (AI therapy responses)
BEDROCK_MODEL_ID="anthropic.claude-sonnet-4-6"

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Stripe (payment processing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Frontend Environment Variables (VITE_* prefix required)
VITE_API_URL="https://your-api-id.execute-api.eu-west-2.amazonaws.com/prod"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
VITE_COGNITO_USER_POOL_ID="eu-west-2_xxxxxxxxx"
VITE_COGNITO_CLIENT_ID="your-cognito-client-id"

# CloudFormation Stack Parameters
FRONTEND_BUCKET_NAME="resolve-therapy-frontend"
TABLE_NAME="resolve-therapy"
STACK_NAME="resolve-therapy"
